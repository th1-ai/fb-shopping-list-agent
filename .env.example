# F&B Shopping List Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.

# ============================================================
# Hotel identity
# ============================================================

HOTEL_NAME="Your Hotel Name"

# ============================================================
# PMS (Property Management System) integration
# ============================================================
# The agent uses these tools to project guest counts for the
# upcoming shopping window.

PMS_PROPERTY_ID="{{PMS_PROPERTY_ID}}"
PMS_LOOKUP_TOOL="tools/pms_lookup.py"

# ============================================================
# Inventory + shopping list sheets
# ============================================================
# Two-tab inventory sheet:
#   - Inventory tab: master list of items, consumption model,
#     guests-per-unit (or par-min/par-target).
#   - Stock tab: most recent staff-entered counts of each item.
# Shopping-list sheet: where the agent writes the proposed list
# after approval. (Can be the same sheet on a different tab.)

SHEET_ID_INVENTORY="{{SHEET_ID_INVENTORY}}"
SHEET_ID_SHOPPING_LIST="{{SHEET_ID_SHOPPING_LIST}}"

# ============================================================
# Special-room flag (optional)
# ============================================================
# If you want the list to auto-add an item (e.g. a bouquet)
# whenever a check-in for a specific room type falls in the
# shopping window, set the room-type ID here.

PREMIUM_ROOM_TYPE_ID=""

# ============================================================
# Optional — email the proposed list to a delivery service
# ============================================================

# GROCERY_DELIVERY_EMAIL="orders@yourgrocer.example"
