# F&B Shopping List Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.
#
# The agent itself only checks SHEET_ID_INVENTORY. The other values are
# read by the shopping-list tool that you supply (see README, "The tool
# you supply"). Add your tool's own credentials (PMS API key, Google
# service account path) below; this template does not name them because
# they depend on your PMS and your scripts.

# ============================================================
# PMS (Property Management System)
# ============================================================
# The property whose reservations give the guest counts for the
# shopping window.

PMS_PROPERTY_ID="{{PMS_PROPERTY_ID}}"

# ============================================================
# Inventory + shopping list sheets
# ============================================================
# Inventory sheet tabs:
#   - Inventory: master list of items, consumption model,
#     guests-per-unit (or par-min / par-target).
#   - Stock: most recent staff-entered counts of each item.
#   - Calibration: "ran-out" / "over-stocked" events logged by the tool.
# Shopping-list sheet: where the tool writes the list after approval.
# (Can be the same sheet on a different tab.)

SHEET_ID_INVENTORY="{{SHEET_ID_INVENTORY}}"
SHEET_ID_SHOPPING_LIST="{{SHEET_ID_SHOPPING_LIST}}"

# ============================================================
# Special-room flag (optional)
# ============================================================
# To auto-add an item (e.g. a bouquet) for each check-in of one
# room type inside the shopping window, set the room-type ID here.
# Leave empty to switch this off.

PREMIUM_ROOM_TYPE_ID=""
